{
  "name": "dsh-web-connect",
  "version": "0.1.0",
  "type": "module",
  "description": "让 DSH 智能体在验证浏览器里登录并检查自身界面，也能按用户要求在系统默认浏览器打开网页版；不依赖外部脚本。",
  "author": "Song-812",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Song-812/dsh-plugins-song.git",
    "directory": "web-connect"
  },
  "homepage": "https://github.com/Song-812/dsh-plugins-song/tree/main/web-connect",
  "bugs": {
    "url": "https://github.com/Song-812/dsh-plugins-song/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "browser",
    "authentication",
    "web"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
