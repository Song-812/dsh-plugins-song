{
  "name": "dsh-proxy-connect",
  "version": "1.0.0",
  "type": "module",
  "description": "两条路共用一个开关和一份名单：抓网页（名单内走代理；名单外先直连，连不上才转代理并记进名单）与模型出网（名单内走代理，其余一律直连）。界面只用插件面板里的启停开关。",
  "author": "Song-812",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Song-812/dsh-plugins-song.git",
    "directory": "proxy-connect"
  },
  "homepage": "https://github.com/Song-812/dsh-plugins-song/tree/main/proxy-connect",
  "bugs": {
    "url": "https://github.com/Song-812/dsh-plugins-song/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "proxy",
    "egress",
    "whitelist"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "whitelist.example.json",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "undici": "^8.12.1"
  }
}
