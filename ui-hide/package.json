{
  "name": "dsh-ui-hide",
  "version": "0.2.0",
  "type": "module",
  "description": "按清单隐藏不需要的界面入口，并把会话「…」菜单里的「重命名」搬到会话行上。隐藏只叠一条 display:none 样式，不改程序文件、不删任何功能。清单在 $DSH_HOME/ui-hide.json（默认 ~/.dsh/ui-hide.json），改完刷新页面生效。",
  "author": "Song-812",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Song-812/dsh-plugins-song.git",
    "directory": "ui-hide"
  },
  "homepage": "https://github.com/Song-812/dsh-plugins-song/tree/main/ui-hide",
  "bugs": {
    "url": "https://github.com/Song-812/dsh-plugins-song/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "ui",
    "hide"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "ui-hide.example.json",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/host-smoke.mjs && node test/client-smoke.mjs && node test/row-rename.mjs && node test/trigger-pick.mjs && node --test test/route-dispose.test.mjs"
  }
}
