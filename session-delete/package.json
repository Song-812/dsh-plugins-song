{
  "name": "dsh-session-delete",
  "version": "0.1.1",
  "type": "module",
  "description": "会话列表每行悬停出一个垃圾桶，确认后把会话目录送进 Windows 回收站。",
  "author": "Song-812",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Song-812/dsh-plugins-song.git",
    "directory": "session-delete"
  },
  "homepage": "https://github.com/Song-812/dsh-plugins-song/tree/main/session-delete",
  "bugs": {
    "url": "https://github.com/Song-812/dsh-plugins-song/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
